\\FINDING IF THE ENTERD NUMBER IS NATURAL OR NOT.

#include <stdio.h>

int main() {
    int a;
    printf("Enter an integer: ");
    scanf("%d", &a);

    if (a> 0) {
        printf("The number is natural number.\n");
    } else if (a < 0) {
        printf("The number is not natural.\n");
    } else {
        printf("The number is zero.\n");
    }
}
